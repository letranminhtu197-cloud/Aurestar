{
  "name": "aurestar-desktop",
  "version": "2.0.0",
  "description": "Aurestar desktop task and focus workspace",
  "author": "Aurestar",
  "license": "UNLICENSED",
  "main": "src/main.cjs",
  "scripts": {
    "test": "node test/core.test.cjs",
    "check": "node scripts/check-source.cjs",
    "icon": "node scripts/make-icon.cjs",
    "electron:setup": "node node_modules/electron/install.js",
    "dist:win": "npm run electron:setup && npm run icon && npm run check && electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.aurestar.desktop",
    "productName": "Aurestar",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.map",
      "!src/**/test/**"
    ],
    "extraResources": [
      {
        "from": "resources/aurestar-chrome/background.js",
        "to": "aurestar-chrome/background.js"
      },
      {
        "from": "resources/itsuki",
        "to": "itsuki"
      }
    ],
    "artifactName": "Aurestar-${version}-${arch}.${ext}",
    "win": {
      "icon": "src/icons/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Aurestar-${version}-Portable-${arch}.${ext}"
    }
  }
}
